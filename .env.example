# ===========================================
# POS-Crispy-Catfish Environment Configuration
# ===========================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=pos_user
DB_PASSWORD=CHANGE_ME
DB_NAME=pos_crispy_catfish
DB_SSLMODE=disable

# --- Backend ---
BACKEND_PORT=8080
GIN_MODE=debug
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=336h

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Payment Provider ---
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=CHANGE_ME

# --- Restaurant Config ---
RESTAURANT_NAME=PLACEHOLDER_RESTAURANT_NAME
RESTAURANT_ADDRESS=PLACEHOLDER_ADDRESS
RESTAURANT_LAT=0.0
RESTAURANT_LNG=0.0
DELIVERY_RADIUS_KM=7
