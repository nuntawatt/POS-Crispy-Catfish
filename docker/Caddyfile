# Development Caddyfile
# TODO: Update with production domain
:80 {
    # API proxy
    handle /api/* {
        reverse_proxy backend:8080
    }

    # WebSocket proxy
    handle /ws/* {
        reverse_proxy backend:8080
    }

    # Health check proxy
    handle /health {
        reverse_proxy backend:8080
    }

    # Frontend
    handle {
        reverse_proxy frontend:80
    }
}
